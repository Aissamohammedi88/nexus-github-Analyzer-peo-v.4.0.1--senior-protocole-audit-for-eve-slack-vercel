def get_local_ip():
try:
s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
s.settimeout(2)
s.connect(("8.8.8.8", 80))
ip = s.getsockname()[0]
s.close()
return ip
except Exception:
return "127.0.0.1"


def trouver_port_libre(port_depart, max_tentatives=None):
if max_tentatives is None:
max_tentatives = MAX_PORT_SCAN
for p in range(port_depart, port_depart + max_tentatives):
try:
with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
s.bind(("0.0.0.0", p))
return p
except OSError:
continue
return None


def ouvrir_navigateur(port):
try:
url = f"http://localhost:{port}/"
threading.Thread(
target=lambda: (time.sleep(1.5), webbrowser.open(url)),
daemon=True).start()
except Exception:
pass


