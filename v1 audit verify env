class GitHubClient:
def __init__(self, token=None):
self.token = token
self.cache = {}
self.cache_ttl = 300
self._lock = threading.Lock()

def _headers(self):
h = {"User-Agent": f"NexusAnalyzer/{VERSION}",
"Accept": "application/vnd.github.v3+json"}
if self.token:
h["Authorization"] = f"token {self.token}"
return h

def _cache_key(self, url):
return hashlib.sha256(url.encode()).hexdigest()[:16]

def _get_cache(self, url):
key = self._cache_key(url)
with self._lock:
e = self.cache.get(key)
if e and time.time() - e["time"] < self.cache_ttl:
return e["data"]
return None

def _set_cache(self, url, data):
key = self._cache_key(url)
with self._lock:
self.cache[key] = {"data": data, "time": time.time()}

def api_get(self, endpoint, timeout=15):
url = f"https://api.github.com/{endpoint.lstrip('/')}"
c = self._get_cache(url)
if c:
try:
return json.loads(c)
except Exception:
pass
try:
req = urllib.request.Request(url, headers=self._headers())
with urllib.request.urlopen(req, timeout=timeout) as r:
data = r.read().decode("utf-8", errors="ignore")
self._set_cache(url, data)
return json.loads(data)
except urllib.error.HTTPError as e:
if e.code == 404:
return None
if e.code == 403:
return {"_rate_limited": True}
return None
except Exception:
return None

def raw_get(self, repo, path, branch="main", timeout=10, _rec=0):
if _rec > 1:
return None
url = f"https://raw.githubusercontent.com/{repo}/{branch}/{path}"
c = self._get_cache(url)
if c:
return c
h = {"User-Agent": f"NexusAnalyzer/{VERSION}"}
if self.token:
h["Authorization"] = f"token {self.token}"
try:
req = urllib.request.Request(url, headers=h)
with urllib.request.urlopen(req, timeout=timeout) as r:
data = r.read().decode("utf-8", errors="ignore")
self._set_cache(url, data)
return data
except Exception:
if branch == "main":
return self.raw_get(repo, path, "master", timeout, _rec + 1)
return None


def extraire_repo(url):
if not url:
return ""
url = url.strip().rstrip("/")
url = re.sub(r"\.git$", "", url)
url = re.sub(r"^https?://github\.com/", "", url)
url = re.sub(r"^git@github\.com:", "", url)
url = re.sub(r"^github\.com/", "", url)
return url.split("?")[0].split("#")[0]


