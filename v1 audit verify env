class NexusAnalyzer:
def __init__(self, token=None):
self.client = GitHubClient(token)
self.analyzers = [
check_01_info, check_02_structure, check_03_lockfile,
check_04_engines, check_05_env, check_06_channel,
check_07_instructions, check_08_tools, check_09_manifest,
check_10_security, check_11_vercel, check_12_completeness]

def analyze(self, repo, parallel=True):
start = time.time()
results = []
if parallel:
with ThreadPoolExecutor(max_workers=6) as ex:
futures = {ex.submit(fn, self.client, repo): fn.__name__
for fn in self.analyzers}
for f in as_completed(futures):
try:
results.append(f.result())
except Exception as e:
r = AnalysisResult(futures[f], "error")
r.add("err", f"Erreur interne : {e}", "high")
results.append(r)
else:
for fn in self.analyzers:
try:
results.append(fn(self.client, repo))
except Exception as e:
r = AnalysisResult(fn.__name__, "error")
r.add("err", f"Erreur interne : {e}", "high")
results.append(r)
duration = time.time() - start
ordre = {fn.__name__: i for i, fn in enumerate(self.analyzers)}
results.sort(key=lambda r: ordre.get(r.name, 99))
total_score = sum(r.score for r in results)
total_max = sum(r.max_score for r in results)
percent = round(total_score / total_max * 100, 1) if total_max > 0 else 0
all_issues = []
all_fixes = []
for r in results:
all_issues.extend(r.issues)
all_fixes.extend(r.fixes)
return {
"version": VERSION, "author": AUTHOR, "protocole": PROTOCOLE,
"repo": repo,
"timestamp": datetime.now(timezone.utc).isoformat(),
"duration_seconds": round(duration, 2),
"global_score": percent,
"total_issues": len(all_issues),
"total_fixes": len(all_fixes),
"results": [r.to_dict() for r in results],
"issues": all_issues, "fixes": all_fixes}


