def check_03_lockfile(client, repo):
r = AnalysisResult("Lockfile & Dépendances", "deps")
pkg = client.raw_get(repo, "package.json")
pnpm = client.raw_get(repo, "pnpm-lock.yaml")
npm = client.raw_get(repo, "package-lock.json")
yarn = client.raw_get(repo, "yarn.lock")
if not pkg:
r.add("err", "package.json introuvable", "critical",
"Ajoute package.json à la racine")
return r
r.add("ok", "package.json trouvé")
lock = pnpm or npm or yarn
if not lock:
r.add("err", "Aucun lockfile trouvé", "critical",
"Exécute pnpm install", "pnpm install")
return r
if pnpm:
r.add("ok", "Lockfile pnpm trouvé")
lt = "pnpm"
elif npm:
r.add("ok", "Lockfile npm trouvé")
lt = "npm"
else:
r.add("ok", "Lockfile yarn trouvé")
lt = "yarn"
try:
p = json.loads(pkg)
except json.JSONDecodeError as e:
r.add("err", f"package.json invalide : {e}", "critical",
"Corrige la syntaxe JSON")
return r
deps = {}
for k in ("dependencies", "devDependencies", "peerDependencies", "optionalDependencies"):
deps.update(p.get(k, {}))
if not deps:
r.add("warn", "Aucune dépendance déclarée", "low")
return r
r.add("ok", f"{len(deps)} dépendances déclarées")
if lt == "pnpm":
mm = []
for name in deps.keys():
if not (f"/{name}@" in lock or f"'{name}':" in lock or
f'"{name}":' in lock or f"\n {name}:" in lock):
mm.append(name)
if mm:
r.add("err", f"⚠️ {len(mm)} dépendance(s) manquante(s) dans pnpm-lock.yaml",
"critical",
"Cause probable de ERR_PNPM_OUTDATED_LOCKFILE sur Vercel !",
"rm pnpm-lock.yaml && pnpm install && git add pnpm-lock.yaml && git commit -m 'fix: sync lockfile' && git push")
for m in mm[:8]:
r.add("info", f" → {m}")
return r


