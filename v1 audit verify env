if not d:
r.add("err", "Dépôt introuvable ou inaccessible", "critical",
"Vérifie l'URL et tes droits d'accès")
return r
if d.get("_rate_limited"):
r.add("warn", "Rate limit GitHub atteint", "medium",
"Utilise un token GitHub avec GITHUB_TOKEN=xxx")
return r
r.add("ok", f"Dépôt : {d.get('full_name', 'N/A')}")
r.add("ok", f"Description : {(d.get('description') or 'aucune')[:80]}")
r.add("ok", f"Langage : {d.get('language', 'N/A')}")
r.add("ok", f"Stars : {d.get('stargazers_count', 0)}")
r.add("ok", f"Forks : {d.get('forks_count', 0)}")
