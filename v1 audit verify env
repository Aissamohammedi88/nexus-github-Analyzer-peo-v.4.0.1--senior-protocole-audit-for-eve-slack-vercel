class AnalysisResult:
def __init__(self, name, category="general"):
self.name = name
self.category = category
self.checks = []
self.fixes = []
self.issues = []
self.score = 0.0
self.max_score = 0
self._lock = threading.Lock()

def add(self, status, message, severity="info", fix=None, code=None):
with self._lock:
self.checks.append({"status": status, "message": message, "severity": severity})
self.max_score += 1
if status == "ok":
self.score += 1
elif status == "warn":
self.score += 0.5
if status in ("err", "warn") and fix:
self.fixes.append({"message": message, "fix": fix,
"code": code or "", "severity": severity})
if status == "err":
self.issues.append({"level": "error", "severity": severity,
"message": message})

def to_dict(self):
with self._lock:
return {
"name": self.name, "category": self.category,
"checks": list(self.checks), "fixes": list(self.fixes),
"issues": list(self.issues), "score": round(self.score, 1),
"max_score": self.max_score,
"percent": round(self.score / self.max_score * 100, 1)
if self.max_score > 0 else 0,
}


